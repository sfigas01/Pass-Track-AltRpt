# Copy to .env for local development. Never commit real values.

# Postgres connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/passtrack

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Public base URL of the app, used to build the Google OAuth callback
# (<PUBLIC_URL>/api/callback). Local: http://localhost:5000
PUBLIC_URL=http://localhost:5000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed to sign in.
ALLOWED_EMAILS=

# Optional: comma-separated origins allowed by CORS in production.
# ALLOWED_ORIGINS=https://your-app.up.railway.app
